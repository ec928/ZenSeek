<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
         xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
         Title="Text Search Tool" Height="740" Width="850" WindowStartupLocation="CenterScreen" Background="#1E293B" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="4,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        
        <Style TargetType="Button">
            <Setter Property="Padding" Value="15,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#0F172A"/>
        </Style>
        
        <Style TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#0F172A"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="Padding" Value="3,2"/>
            <Setter Property="Foreground" Value="Black"/>
            <Style.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="Black"/>
                </Style>
            </Style.Resources>
        </Style>
    </Window.Resources>
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="220"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Border Grid.Row="0" Background="#2F3E51" CornerRadius="6" Padding="15" Margin="0,0,0,12" BorderBrush="#0F172A" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Directory:" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                    <ComboBox Name="cmbDir" Grid.Column="1" IsEditable="True" Margin="0,0,8,0"/>
                    <Button Name="btnBrowse" Grid.Column="2" Content="..." Padding="12,2" Margin="0,0,12,0" Width="36" ToolTip="Browse for folder"/>
                    <CheckBox Name="chkSubfolders" Grid.Column="3" Content="Include Subfolders" IsChecked="True"/>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Search:" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                    <ComboBox Name="cmbStr" Grid.Column="1" IsEditable="True" Margin="0,0,8,0"/>
                    
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,12,0">
                        <ToggleButton Name="chkWholeWordMain" Content="&quot;&quot;" Margin="0,0,5,0" Width="34" Height="28" ToolTip="Match Whole Word" FontFamily="Consolas" FontSize="14" FontWeight="Bold"/>
                        <ToggleButton Name="chkCaseMain" Content="Aa" Margin="0,0,5,0" Width="34" Height="28" ToolTip="Match Case" FontFamily="Consolas" FontSize="14" FontWeight="Bold"/>
                        <ToggleButton Name="chkRegex" Content=".*" Width="34" Height="28" ToolTip="Use Regular Expressions" FontFamily="Consolas" FontSize="14" FontWeight="Bold"/>
                    </StackPanel>

                    <Button Name="btnSearch" Grid.Column="3" Content="Search" Width="100" Height="28" FontWeight="SemiBold" Background="#0078D4" Foreground="White" BorderThickness="0"/>
                </Grid>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="File Filter:" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                    <ComboBox Name="txtFilter" Grid.Column="1" IsEditable="True" Text="*.txt, *.md, *.csv, *.epub, *.docx, *.xlsx" Margin="0,0,15,0"/>
                    <TextBlock Text="Exclude:" Grid.Column="2" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                    <ComboBox Name="txtExcl" Grid.Column="3" IsEditable="True" Text="*.exe, *.dll, *.png, *.jpg" Margin="0,0,12,0"/>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#2F3E51" CornerRadius="4" BorderBrush="#0F172A" BorderThickness="1" ClipToBounds="True">
            <ListView Name="lstResults" Background="#F1F5F9" Foreground="Black" BorderThickness="0" Margin="-6,-2,-6,0">
                 <ListView.Resources>
                    <Style TargetType="GridViewColumnHeader">
                        <Setter Property="Foreground" Value="#F8FAFC"/>
                        <Setter Property="Padding" Value="6,4"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="GridViewColumnHeader">
                                    <Border Background="#2F3E51" BorderBrush="#1E293B" BorderThickness="0,0,1,1" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                 </ListView.Resources>

                 <ListView.ContextMenu>
                     <ContextMenu>
                        <MenuItem Name="mOpen" Header="Open (Default)"/>
                        <MenuItem Name="mWith" Header="Open With..."/>
                        <MenuItem Name="mLoc" Header="Open File Location"/>
                        <Separator/>
                        <MenuItem Name="mPrev" Header="Open in Modern Reader"/>
                        <MenuItem Name="mExport" Header="Export Results to CSV"/>
                    </ContextMenu>
                </ListView.ContextMenu>
            
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="260"/>
                        <GridViewColumn Header="Date Modified" DisplayMemberBinding="{Binding DateModified}" Width="140"/>
                        <GridViewColumn Header="Size" Width="95">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Stretch" MinWidth="75">
                                        <TextBlock Text="{Binding Size}" TextAlignment="Right" Margin="0,0,5,0" Foreground="Black"/>
                                    </Grid>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Folder" DisplayMemberBinding="{Binding Folder}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="Transparent" VerticalAlignment="Center" ShowsPreview="True"/>

        <Border Grid.Row="3" Background="#1E293B" CornerRadius="4" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,8">
            <TextBox Name="txtInlinePreview" 
                     IsReadOnly="True" 
                     TextWrapping="Wrap" 
                     VerticalScrollBarVisibility="Auto" 
                     FontFamily="Source Sans 3, Inter, Segoe UI"
                     FontSize="16" 
                     Background="#2F3E51" 
                     Foreground="#E2E8F0"
                     BorderThickness="0" 
                     Padding="16,14"
                     TextOptions.TextFormattingMode="Display"
                     TextOptions.TextRenderingMode="ClearType" />
        </Border>

        <DockPanel Grid.Row="4" Margin="2,4,2,0" LastChildFill="False" Background="Transparent">
            <TextBlock Name="statusLabel" Text="Ready." Foreground="#CBD5E1" DockPanel.Dock="Left" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <TextBlock Text="Context:" Foreground="#CBD5E1" Margin="0,0,4,0" VerticalAlignment="Center" FontSize="12"/>
                <wfi:WindowsFormsHost Name="numInlineContextHost" Width="45" Margin="0,0,12,0">
                    <wf:NumericUpDown Minimum="0" Maximum="100" Value="4" Width="45" Height="23" />
                </wfi:WindowsFormsHost>
                <TextBlock Name="lblInlineStatus" Text="" Foreground="#CBD5E1" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="12"/>
                <Button Name="btnInlinePrev" Content="&lt;" Width="26" Height="20" Margin="0,0,4,0" Padding="0" VerticalContentAlignment="Center"/>
                <Button Name="btnInlineNext" Content="&gt;" Width="26" Height="20" Padding="0" VerticalContentAlignment="Center"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>